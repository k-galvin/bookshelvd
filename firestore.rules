rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile permissions
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // List subcollection permissions
      match /lists/{listId} {
        // Anyone can read a list if it is public
        allow read: if resource == null || resource.data.isPublic == true;
        // Only the owner can delete or modify content, but others can update likes
        allow write: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
                      && request.resource.data.name == resource.data.name
                      && request.resource.data.books == resource.data.books
                      && request.resource.data.description == resource.data.description
                      && request.resource.data.isPublic == resource.data.isPublic;
      }
    }
    
    // Collection Group permission for public list queries
    match /{path=**}/lists/{listId} {
      allow read: if resource.data.isPublic == true;
    }
  }
}
